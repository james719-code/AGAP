<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splash_background"
    android:clipToPadding="false">

    <!-- Soft moving color field at the bottom. -->
    <com.travelingsalesman.agap.ui.screens.splash.v2.WaveView
        android:id="@+id/waveView"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_gravity="bottom"
        android:alpha="0" />

    <!-- Main AGAP branding. -->
    <LinearLayout
        android:id="@+id/brandSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:translationY="-42dp">

        <ImageView
            android:id="@+id/logoView"
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:alpha="0"
            android:scaleY="0.85"
            android:scaleX="0.85"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/splash_logo" />
    </LinearLayout>

    <!-- Loading indicator remains readable over the pale waves. -->
    <LinearLayout
        android:id="@+id/loadingSection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="34dp"
        android:alpha="0"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.travelingsalesman.agap.ui.screens.splash.v2.LoadingDotsView
            android:id="@+id/loadingDots"
            android:layout_width="92dp"
            android:layout_height="28dp" />

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans"
            android:text="@string/splash_loading"
            android:textColor="@color/splash_text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
