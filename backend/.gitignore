dist/
main
main.exe
backend
*.exe
*.exe~
*.dll
*.so
*.dylib

# SQLite Database Files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Test and Coverage Artifacts
*.test
