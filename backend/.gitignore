# Go / Backend Specific .gitignore

# Compiled Binaries & Executables
bin/
dist/
main
main.exe
backend
backend.exe
*.exe
*.exe~
*.dll
*.so
*.dylib

# SQLite Database Files
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# Test and Coverage Artifacts
*.test
*.out
*.prof
coverage.txt
coverage.out

# Environment & Secret Files
*.env
*.env.*
!.env.example
!.env.*.example
!*.env.example

# IDE, Editors & OS Files
.idea/
.vscode/
.gemini/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs & Temporary Files
logs/
*.log
tmp/
*.tmp
*.bak
*.pdf
