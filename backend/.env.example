# AGAP Backend Configuration
# Development defaults are intentionally convenient. For production, replace
# every secret and use ENV=production so production safeguards are enforced.

HOST=0.0.0.0
PORT=8080
ENV=development

# Database
DB_TYPE=sqlite
DB_FILE_PATH=./agap_gis.db
# DB_DSN=  # reserved for alternate database configuration

# Security (CHANGE BOTH before ENV=production)
JWT_SECRET=agap_backend_jwt_secret_key_2026
AES_SECRET_KEY=0123456789abcdef0123456789abcdef

# Browser origins allowed to call the API. Wildcard is rejected in production.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Telemetry integrity. Keep false while existing Android clients do not yet send
# X-AGAP-Signature; set true once all telemetry clients are updated.
REQUIRE_TELEMETRY_HMAC=false

# Development-only DB/API explorer. Defaults to false automatically in production.
ENABLE_SYSTEM_EXPLORER=true

# Request / ingestion protection
MAX_REQUEST_BODY_BYTES=2097152
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
DEDUP_TTL_SECONDS=300

# Optional static frontend directory served by the Go process.
# STATIC_DIR=../frontend/dist

# Preprocessed Android offline road-routing SQLite package
ROUTING_GRAPH_PATH=/opt/agap/maps/deployment-routing.db
