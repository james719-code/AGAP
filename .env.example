# AGAP Project Environment Variables Example (Root)
# Copy this file to .env for local orchestration

NODE_ENV=development
PROJECT_NAME=AGAP
PROJECT_REGION=Legazpi_City_PH

# API & Gateway Ports
BACKEND_PORT=8080
FRONTEND_PORT=5173

# Database & Spatial Data
DB_TYPE=sqlite
DB_FILE_PATH=./agap_gis.db

# Geolocation & OpenStreetMap Tile Server
OSM_TILE_SERVER_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Security & Encryption Keys
JWT_SECRET=super_secret_jwt_key_change_in_production
TELEMETRY_AES_KEY=32_byte_hex_key_for_ble_packet_payload_encryption
