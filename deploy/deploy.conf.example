# AGAP Backend Service — Deploy Configuration
# Copy this to deploy/deploy.conf and fill in your server details:
#   cp deploy/deploy.conf.example deploy/deploy.conf
#
# deploy.conf is gitignored — it contains your server's IP/hostname.

# --- Server connection ---
DEPLOY_HOST=your-server-domain-or-ip.com
DEPLOY_USER=deploy
DEPLOY_PORT=22

# --- Remote paths ---
# Isolated project directories for AGAP (avoiding conflict with other apps):
BACKEND_DIR=/opt/agap/backend
FRONTEND_DIR=/opt/agap/frontend
DATABASE_DIR=/var/lib/agap
LOG_DIR=/var/log/agap

# Default fallback if custom paths above are commented out:
REMOTE_DIR=/opt/agap

# --- Self-hosted routing (optional) ---
# Stage the nginx site without enabling it or changing other sites by default.
# Set true only when you intend to activate AGAP on this server.
NGINX_ACTIVATE=false
# Only enable the public Funnel on a dedicated/explicitly configured host.
TAILSCALE_FUNNEL_ENABLE=false

# --- Local build dir ---
BUILD_DIR=build

# --- SSH key (optional — leave empty to use default ~/.ssh/id_rsa) ---
SSH_KEY=
