# Frontend Vite / React .gitignore

# Dependencies
node_modules/
.pnpm-store/

# Production Build Outputs
dist/
dist-ssr/
build/
coverage/
.nyc_output/

# Environment & Secret Files
*.env
*.env.*
!.env.example
!.env.*.example
!*.env.example

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE, Editors & OS Files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# Temporary Files, PDF & Build Artifacts
tmp/
*.tmp
*.bak
*.pdf
