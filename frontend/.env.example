# Frontend Environment Variables
VITE_APP_TITLE=AGAP Command Center & Emergency Dispatch Dashboard
# go | cloudflare | supabase | firebase
VITE_API_PROVIDER=go
VITE_API_BASE_URL=/agap/api/v1
VITE_WS_URL=/agap/ws
# Optional for Supabase Edge Functions. Use only the public publishable key.
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
